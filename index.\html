<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sashka Messenger v4.0</title>
    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
    <script src="https://unpkg.com/peerjs@1.5.1/dist/peerjs.min.js"></script>
    <style>
        :root {
            --bg: #0a0a0a;
            --surface: #141414;
            --surface2: #1e1e1e;
            --surface3: #282828;
            --text: #e8e8e8;
            --text2: #999;
            --accent: #5b9bd5;
            --accent2: #4a8ac4;
            --green: #4caf84;
            --red: #e0555a;
            --orange: #e8a84c;
            --purple: #9b59b6;
            --border: #2a2a2a;
            --radius: 12px;
            --radius-sm: 8px;
            --shadow: 0 2px 20px rgba(0,0,0,0.6);
            --font: 'Segoe UI', system-ui, -apple-system, sans-serif;
            --sidebar-width: 320px;
        }
        .light {
            --bg: #f5f5f5;
            --surface: #fff;
            --surface2: #f0f0f0;
            --surface3: #e5e5e5;
            --text: #1a1a1a;
            --text2: #666;
            --border: #ddd;
            --shadow: 0 2px 20px rgba(0,0,0,0.1);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: var(--font);
            background: #000;
            color: var(--text);
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.3s, color 0.3s;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        .app {
            width: 100vw;
            height: 100vh;
            height: 100dvh;
            max-width: 100%;
            max-height: 100%;
            display: flex;
            overflow: hidden;
            box-shadow: var(--shadow);
            background: var(--surface);
            position: relative;
        }
        .sidebar {
            width: var(--sidebar-width);
            min-width: var(--sidebar-width);
            max-width: var(--sidebar-width);
            background: var(--surface);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            transition: transform 0.3s;
            z-index: 5;
            position: relative;
        }
        .sidebar-header {
            padding: 12px;
            border-bottom: 1px solid var(--border);
            background: var(--surface2);
            flex-shrink: 0;
        }
        .sidebar-header h2 {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .search-box {
            width: 100%;
            padding: 8px 12px;
            border-radius: 18px;
            border: 1px solid var(--border);
            background: var(--surface3);
            color: var(--text);
            font-size: 0.85rem;
            outline: none;
        }
        .search-box:focus { border-color: var(--accent); }
        .chat-tabs {
            display: flex;
            gap: 2px;
            padding: 6px 8px;
            border-bottom: 1px solid var(--border);
            background: var(--surface2);
            overflow-x: auto;
            flex-shrink: 0;
        }
        .chat-tab {
            padding: 5px 10px;
            border-radius: 14px;
            border: none;
            background: transparent;
            color: var(--text2);
            cursor: pointer;
            font-size: 0.7rem;
            font-weight: 600;
            white-space: nowrap;
        }
        .chat-tab.active { background: var(--accent); color: #fff; }
        .chat-list {
            flex: 1;
            overflow-y: auto;
            padding: 4px 6px;
        }
        .chat-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.15s;
            margin-bottom: 1px;
        }
        .chat-item:hover { background: var(--surface2); }
        .chat-item.active { background: var(--accent); color: #fff; }
        .chat-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
            background: var(--surface3);
            background-size: cover;
            background-position: center;
            overflow: hidden;
        }
        .chat-info { flex: 1; min-width: 0; }
        .chat-name { font-weight: 600; font-size: 0.85rem; }
        .chat-preview { font-size: 0.7rem; color: var(--text2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .badge { display: inline-block; padding: 2px 6px; border-radius: 8px; font-size: 0.6rem; font-weight: 700; margin-left: 3px; }
        .badge.creator { background: var(--purple); color: #fff; }
        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: var(--bg);
            min-width: 0;
        }
        .main-header {
            padding: 10px 12px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--surface);
            flex-shrink: 0;
        }
        .back-btn {
            width: 32px; height: 32px; border-radius: 50%; border: none;
            background: var(--surface2); color: var(--text); cursor: pointer;
            font-size: 1rem; display: none; align-items: center; justify-content: center;
        }
        .main-header-info { flex: 1; min-width: 0; }
        .main-header-info .name { font-weight: 700; font-size: 0.9rem; }
        .messages-area {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .msg {
            max-width: 80%;
            padding: 8px 12px;
            border-radius: var(--radius-sm);
            font-size: 0.85rem;
            line-height: 1.3;
            animation: msgIn 0.2s ease-out;
            word-break: break-word;
        }
        @keyframes msgIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
        .msg.sent { align-self: flex-end; background: var(--accent); color: #fff; }
        .msg.received { align-self: flex-start; background: var(--surface2); }
        .msg.system { align-self: center; background: var(--surface3); color: var(--text2); font-size: 0.7rem; max-width: 90%; text-align: center; border-radius: 10px; padding: 5px 10px; }
        .msg .msg-sender { font-weight: 700; font-size: 0.7rem; margin-bottom: 2px; }
        .msg img.msg-image { max-width: 200px; border-radius: 8px; margin-top: 4px; cursor: pointer; }
        .msg video.msg-video-circle { width: 180px; height: 180px; border-radius: 50%; object-fit: cover; margin-top: 4px; cursor: pointer; background: #000; }
        .msg a.msg-file { display: inline-block; padding: 8px 12px; background: var(--surface3); border-radius: 8px; color: var(--accent); text-decoration: none; margin-top: 4px; }
        .msg a.msg-file:hover { background: var(--accent); color: #fff; }
        .input-area {
            padding: 8px 10px;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 6px;
            background: var(--surface);
            flex-shrink: 0;
        }
        .input-area textarea {
            flex: 1; resize: none; border-radius: 18px;
            border: 1px solid var(--border); background: var(--surface2);
            color: var(--text); padding: 8px 12px; font-size: 0.85rem;
            outline: none; max-height: 80px; font-family: var(--font);
        }
        .send-btn {
            width: 36px; height: 36px; border-radius: 50%; border: none;
            background: var(--accent); color: #fff; cursor: pointer; font-size: 1rem;
            display: flex; align-items: center; justify-content: center;
        }
        .icon-btn {
            width: 32px; height: 32px; border-radius: 50%; border: none;
            background: var(--surface2); color: var(--text); cursor: pointer;
            font-size: 0.9rem; display: flex; align-items: center; justify-content: center;
        }
        .modal-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 100;
            display: flex; align-items: center; justify-content: center;
        }
        .modal {
            background: var(--surface); border-radius: var(--radius);
            padding: 20px; width: 90%; max-width: 450px; max-height: 85vh;
            overflow-y: auto; box-shadow: var(--shadow);
        }
        .modal input, .modal textarea, .modal select {
            width: 100%; padding: 8px 12px; border-radius: var(--radius-sm);
            border: 1px solid var(--border); background: var(--surface2);
            color: var(--text); font-size: 0.85rem; margin-bottom: 8px;
            outline: none; font-family: var(--font);
        }
        .btn {
            padding: 8px 16px; border-radius: var(--radius-sm); border: none;
            cursor: pointer; font-weight: 600; font-size: 0.85rem;
            background: var(--accent); color: #fff;
        }
        .btn.ghost { background: var(--surface2); color: var(--text); }
        .btn.danger { background: var(--red); }
        .hidden { display: none !important; }
        .toast {
            position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
            background: #333; color: #fff; padding: 8px 16px; border-radius: 16px;
            font-size: 0.8rem; z-index: 200;
        }
        @media (max-width: 768px) {
            .sidebar { position: fixed; left: -100%; top: 0; bottom: 0; width: 100%; z-index: 10; }
            .sidebar.open { left: 0; }
            .back-btn { display: flex; }
        }
    </style>
</head>
<body>
<div class="app" id="app">
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h2>💬 Sashka Messenger</h2>
            <input type="text" class="search-box" id="searchInput" placeholder="🔍 Поиск...">
        </div>
        <div class="chat-tabs" id="chatTabs">
            <button class="chat-tab active" data-filter="all">Все</button>
            <button class="chat-tab" data-filter="private">Личные</button>
            <button class="chat-tab" data-filter="group">Группы</button>
            <button class="chat-tab" data-filter="channel">Каналы</button>
            <button class="chat-tab" data-filter="system">Системные</button>
        </div>
        <div class="chat-list" id="chatList"></div>
        <div style="padding:6px;border-top:1px solid var(--border);display:flex;gap:4px;">
            <button class="icon-btn" id="btnNewChat">➕</button>
            <button class="icon-btn" id="btnProfile">👤</button>
            <button class="icon-btn" id="btnAdmin" style="display:none;">⚙️</button>
            <button class="icon-btn" id="btnTheme">🌓</button>
        </div>
    </div>
    <div class="main" id="mainPanel">
        <div class="main-header">
            <button class="back-btn" id="btnBack">←</button>
            <div class="main-header-info">
                <div class="name" id="mainName">Выберите чат</div>
            </div>
            <div style="display:flex;gap:4px;">
                <button class="icon-btn" id="btnCall" style="display:none;">📞</button>
                <button class="icon-btn" id="btnAttach">📎</button>
            </div>
        </div>
        <div class="messages-area" id="messagesArea"></div>
        <div class="input-area" id="inputArea" style="display:none;">
            <textarea id="msgInput" rows="1" placeholder="Сообщение..."></textarea>
            <button class="send-btn" id="btnSend">➤</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="loginModal">
    <div class="modal">
        <h3>🔐 Вход в Sashka Messenger</h3>
        <input type="text" id="loginName" placeholder="Логин">
        <input type="password" id="loginPass" placeholder="Пароль">
        <button class="btn" id="btnLogin" style="width:100%;">Войти / Зарегистрироваться</button>
    </div>
</div>

<input type="file" id="fileInput" accept="*" style="display:none;">
<div class="toast hidden" id="toast"></div>

<script>
    // ====== ПОДКЛЮЧЕНИЕ К СЕРВЕРУ ======
    const SERVER_URL = 'https://sashka-messenger-server-vqq5.onrender.com';
    const socket = io(SERVER_URL);
    const $ = (s) => document.querySelector(s);

    let currentUser = null;
    let currentChatId = null;
    let chats = [];
    let messagesCache = {};

    // ====== АВТОРИЗАЦИЯ ======
    $('#btnLogin').addEventListener('click', () => {
        const name = $('#loginName').value.trim();
        const pass = $('#loginPass').value;
        if (!name || !pass) return showToast('Введите логин и пароль');
        
        socket.emit('login', { name, password: pass }, (res) => {
            if (res.error) return showToast(res.error);
            currentUser = res.user;
            $('#loginModal').classList.add('hidden');
            loadChats();
            showToast('Добро пожаловать, ' + name + '!');
        });
    });

    // ====== ЗАГРУЗКА ЧАТОВ ======
    function loadChats() {
        socket.emit('get_chats', (serverChats) => {
            chats = serverChats;
            renderChatList();
            if (currentChatId) joinChat(currentChatId);
        });
    }

    function renderChatList() {
        const list = $('#chatList');
        if (!currentUser) return;
        list.innerHTML = chats.map(c => {
            const active = c.id === currentChatId ? ' active' : '';
            const name = c.name || 'Без названия';
            const emoji = c.type === 'system' ? '📋' : c.type === 'suggest' ? '💡' : '💬';
            return `<div class="chat-item${active}" data-chat-id="${c.id}">
                <div class="chat-avatar">${emoji}</div>
                <div class="chat-info"><div class="chat-name">${name}</div></div>
            </div>`;
        }).join('');
        list.querySelectorAll('.chat-item').forEach(el => {
            el.addEventListener('click', () => {
                const id = el.dataset.chatId;
                if (id !== currentChatId) joinChat(id);
            });
        });
    }

    // ====== ВХОД В ЧАТ ======
    function joinChat(chatId) {
        currentChatId = chatId;
        socket.emit('join_chat', chatId);
        socket.emit('get_messages', chatId, (msgs) => {
            messagesCache[chatId] = msgs || [];
            renderMessages();
            $('#inputArea').style.display = 'flex';
            const chat = chats.find(c => c.id === chatId);
            if (chat) $('#mainName').textContent = chat.name || 'Чат';
            if (window.innerWidth <= 768) $('#sidebar').classList.remove('open');
        });
    }

    // ====== ОТПРАВКА СООБЩЕНИЙ ======
    function sendMessage(text) {
        if (!currentChatId || !text.trim()) return;
        socket.emit('send_message', { chatId: currentChatId, text }, (res) => {
            if (res.error) showToast(res.error);
        });
        $('#msgInput').value = '';
    }

    $('#btnSend').addEventListener('click', () => sendMessage($('#msgInput').value));
    $('#msgInput').addEventListener('keypress', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage($('#msgInput').value);
        }
    });

    // ====== ПОЛУЧЕНИЕ СООБЩЕНИЙ ======
    socket.on('new_message', ({ chatId, msg }) => {
        if (!messagesCache[chatId]) messagesCache[chatId] = [];
        if (!messagesCache[chatId].find(m => m.id === msg.id)) {
            messagesCache[chatId].push(msg);
            if (chatId === currentChatId) renderMessages();
            renderChatList();
        }
    });

    function renderMessages() {
        const area = $('#messagesArea');
        if (!currentChatId) { area.innerHTML = ''; return; }
        const msgs = messagesCache[currentChatId] || [];
        area.innerHTML = msgs.map(m => {
            const cls = m.fromId === currentUser?.id ? 'sent' : (m.system ? 'system' : 'received');
            return `<div class="msg ${cls}">
                <div class="msg-sender">${m.from}</div>
                <div>${m.text}</div>
                <div style="font-size:0.6rem;text-align:right;">${new Date(m.time).toLocaleTimeString('ru-RU', {hour:'2-digit',minute:'2-digit'})}</div>
            </div>`;
        }).join('');
        area.scrollTop = area.scrollHeight;
    }

    // ====== ФАЙЛЫ ======
    $('#btnAttach').addEventListener('click', () => $('#fileInput').click());
    $('#fileInput').addEventListener('change', () => {
        const f = $('#fileInput').files[0];
        if (f) {
            const rd = new FileReader();
            rd.onload = () => {
                socket.emit('send_message', {
                    chatId: currentChatId,
                    text: '',
                    file: rd.result,
                    fileType: f.type,
                    fileName: f.name
                });
            };
            rd.readAsDataURL(f);
            $('#fileInput').value = '';
        }
    });

    // ====== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ======
    function showToast(msg) {
        const toast = $('#toast');
        toast.textContent = msg;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 3000);
    }

    // ====== КНОПКИ ======
    $('#btnBack').addEventListener('click', () => {
        if (window.innerWidth <= 768) $('#sidebar').classList.toggle('open');
    });
    $('#btnTheme').addEventListener('click', () => {
        document.body.classList.toggle('light');
    });
    $('#btnProfile').addEventListener('click', () => {
        showToast('Профиль: ' + (currentUser?.name || 'Не авторизован'));
    });
    $('#btnNewChat').addEventListener('click', () => {
        showToast('Создание чатов через интерфейс (в разработке)');
    });

    // Проверка авторизации при загрузке
    if (!currentUser) {
        $('#loginModal').classList.remove('hidden');
    }
</script>
</body>
</html>
